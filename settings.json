{
    "workbench.colorTheme": "GitHub Dark Default",
    "workbench.colorCustomizations": {
        "menu.background": "#0e1016",
        "list.dropBackground":"#0e1016", 
        "input.background": "#0e1016",
        "editorGutter.background": "#0e1016",
        "dropdown.background":  "#0e1016",
        "editorGroupHeader.tabsBackground": "#0e1016",
        "commandCenter.background": "#0e1016",
        "commandCenter.activeBackground":"#0e1016",
        "editor.lineHighlightBackground":"#0e1016",
        "editor.background": "#0e1016", // Editor background
        "sideBar.background": "#0e1016", // Sidebar background
        "activityBar.background": "#0e1016", // Activity bar background
        "titleBar.activeBackground": "#0e1016", // Title bar background
        "titleBar.inactiveBackground": "#0e1016", // Inactive title bar background
        "panel.background": "#0e1016", // Bottom panel background
        "statusBar.background": "#0e1016", // Status bar background
        "statusBar.noFolderBackground": "#0e1016", // Status bar when no folder is open
        "tab.activeBackground": "#0e1016", // Active tab background
        "tab.inactiveBackground": "#0e1016", // Inactive tab background
        "terminal.background": "#0e1016", // Terminal background
        "notificationCenter.background": "#0e1016", // Notification center background
        "notificationToast.background": "#0e1016", // Notification toast background
        "breadcrumb.background": "#0e1016" // Breadcrumb background
    },
    "window.nativeTabs": true,
    "editor.lineNumbers": "relative",
    "editor.minimap.enabled": false,
    "editor.folding": false,
    "editor.renderLineHighlight": "none",
    "vim.useSystemClipboard": true,
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "C-j"
            ],
            "after": [
                "1",
                "0",
                "j",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "C-k"
            ],
            "after": [
                "1",
                "0",
                "k",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "C-l"
            ],
            "after": [
                "$"
            ]
        },
        {
            "before": [
                "C-h"
            ],
            "after": [
                "^"
            ]
        },
        {
            "before": [
                "<C-u>"
            ],
            "after": [
                "<C-u>",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "<C-d>"
            ],
            "after": [
                "<C-d>",
                "z",
                "z"
            ]
        }
    ],
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "C-j"
            ],
            "after": [
                "1",
                "0",
                "j",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "C-k"
            ],
            "after": [
                "1",
                "0",
                "k",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "C-l"
            ],
            "after": [
                "$"
            ]
        },
        {
            "before": [
                "C-h"
            ],
            "after": [
                "^"
            ]
        },
        {
            "before": [
                "<C-u>"
            ],
            "after": [
                "<C-u>",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "<C-d>"
            ],
            "after": [
                "<C-d>",
                "z",
                "z"
            ]
        },
        {
            "before": [
                "<space>",
                "e"
            ],
            "commands": [
                "workbench.action.toggleSidebarVisibility"
            ]
        },
        {
            "before": [
                "<space>",
                "w"
            ],
            "commands": [
                "workbench.action.closeActiveEditor"
            ]
        },
        {
            "before": [
                "u"
            ],
            "after": [],
            "commands": [
                {
                    "command": "undo",
                    "args": []
                }
            ]
        },
        {
            "before": [
                "<C-r>"
            ],
            "after": [],
            "commands": [
                {
                    "command": "redo",
                    "args": []
                }
            ]
        }
    ],
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "terminal.integrated.allowedLinkSchemes": [
        "file",
        "http",
        "https",
        "mailto",
        "vscode",
        "vscode-insiders",
        "docker-desktop"
    ],
}